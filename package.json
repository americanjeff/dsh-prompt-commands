{
  "name": "dsh-prompt-commands",
  "version": "0.4.0",
  "license": "MIT",
  "description": "pi-style prompt templates for dsh: .agents/prompts markdown templates dynamically registered as slash commands, compatible with pi's prompt template format.",
  "author": "American Jeff <jeff@americanjeff.com>",
  "homepage": "https://github.com/americanjeff/dsh-prompt-commands",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/americanjeff/dsh-prompt-commands.git"
  },
  "bugs": {
    "url": "https://github.com/americanjeff/dsh-prompt-commands/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "prompts",
    "slash-commands",
    "templates"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./dist/dsh/client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./lib/template.js": "./lib/template.js",
    "./lib/command.js": "./lib/command.js",
    "./lib/effort.js": "./lib/effort.js"
  },
  "files": [
    "index.js",
    "icon.svg",
    "assets/icon-inline.svg",
    "docs",
    "lib",
    "dist",
    "locale/*.json",
    "dsh.cordis.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.client.json && tsdown",
    "test": "node --test test/*.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh.cordis.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "external": []
    }
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": ">=0.2.0-rc.1",
    "@deepseek-ai/schemastery": ">=3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.5",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3"
  }
}